# Copy to .env and fill in values as needed.
# Existing shell environment variables take precedence over this file.
# Or run: uv run utterscope setup

HF_TOKEN=

# Required when running with --llm (default). Use --no-llm to skip.
# Create a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pauses at or above this many seconds count as long (analyze metrics).
# CLI --long-pause-threshold overrides this value.
UTTERSCOPE_LONG_PAUSE_THRESHOLD=1.0

# Output root for analyze runs (must be absolute when set).
# Default when unset: ./results under the current working directory.
# Each run creates: YYMMDD-n_<audio-stem>/
# UTTERSCOPE_OUTPUT_ROOT=/absolute/path/to/results
#
# Ask for the root every interactive run (1/true). Non-interactive analyze
# errors if this is enabled unless --output is passed.
# UTTERSCOPE_OUTPUT_ASK=0
